# Groq — free tier: https://console.groq.com
GROQ_API_KEY=

# Ollama — self-hosted, no key needed, just run `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace — free tier: https://huggingface.co/settings/tokens
HF_API_KEY=

# Gemini — free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# App
ENVIRONMENT=development
CORS_ORIGINS=["*"]
FRONTEND_URL=http://localhost:5173

# Auth / DB (later phases)
DATABASE_URL=sqlite:///./omnigen.db
JWT_SECRET=change-me

# OAuth login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/oauth/github/callback
