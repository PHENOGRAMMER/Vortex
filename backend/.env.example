# ── Groq (free tier — fast, generous rate limits) ──────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=llama-3.1-8b-instant
GROQ_STRONG_MODEL=llama-3.3-70b-versatile

# ── Ollama (local, self-hosted) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_CODE_MODEL=deepseek-coder-v2

# ── HuggingFace (image generation, free tier) ───────────────────────────────
HF_API_KEY=your_hf_token_here
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-Krea-dev

# ── Gemini (Google AI Studio free tier) ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=OmniGen
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATA_DIR=./backend/storage
ENABLE_LOCAL_IMAGE_GENERATION=true
ENABLE_REMOTE_IMAGE_GENERATION=true

# ── Database & Auth ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./omnigen.db
# IMPORTANT: change JWT_SECRET to a long random string in production!
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173

# ── OAuth (optional — leave blank to disable) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/oauth/github/callback
